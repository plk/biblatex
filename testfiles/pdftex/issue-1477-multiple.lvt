% issue-1477: testing multiple categories via \addbibresource[category=...]

\begin{filecontents}{\jobname.bib}
@book{hectic,
  author    = {Henry Hectic},
  title     = {How Horticulturalists Howl},
  publisher = {Honorary Books},
